{
  "abi": "ilp32e",
  "arch": "riscv32",
  "atomic-cas": false,
  "cpu": "generic-rv32",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S32",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+e,+c,+zcb,+zicond,+zicsr,+forced-atomics",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "ilp32e",
  "llvm-target": "riscv32",
  "max-atomic-width": 32,
  "metadata": { "description": "TinyQV (RV32EC + Zcb + Zicond)", "host_tools": false, "std": false, "tier": 3 },
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-pointer-width": 32
}
